# Never run package lifecycle scripts (install/postinstall) from dependencies.
# `npm run <script>` still works; only pre/post hooks and dependency scripts are skipped.
ignore-scripts=true
# Exact pins only.
save-exact=true
# Stay on the public registry; no telemetry-style extras.
registry=https://registry.npmjs.org/
fund=false
update-notifier=false
